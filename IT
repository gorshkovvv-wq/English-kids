        .faq-answer { margin-top: 10px; display: none; color: #334155; }
        .faq-item.open .faq-answer { display: block; }

        footer { text-align: center; padding: 50px 24px; color: #64748b; font-size: 0.95rem; }

        @keyframes fadeUp { from { opacity: 0; transform: translateY(35px); } to { opacity: 1; transform: translateY(0); } }
        .animate { animation: fadeUp 0.8s ease backwards; }

        @media (max-width: 768px) {
            .hero { min-height: auto; padding: 100px 0 60px; }
            .teacher-block { padding: 36px; flex-direction: column; text-align: center; }
        }
    </style>
</head>
