        .contact-form button {
            width: 100%; padding: 16px; font-size: 1.1rem; font-weight: 600;
            border-radius: 12px; border: none; cursor: pointer;
            background: linear-gradient(135deg, #fbbf24, #f59e0b);
            color: #1e1b4b; transition: 0.3s;
        }
        .contact-form button:hover { transform: translateY(-2px); box-shadow: 0 10px 20px rgba(251,191,36,0.4); }

        /* GAME DAY */
        .gameday-block {
            background: white; border-radius: 32px; padding: 40px 28px;
            box-shadow: 0 15px 30px rgba(0,0,0,0.03); display: inline-block;
