        /* TEACHER */
        .teacher-block {
            display: flex; flex-wrap: wrap; align-items: center; gap: 48px;
            background: white; border-radius: 40px; padding: 56px;
            box-shadow: 0 30px 50px rgba(0,0,0,0.04); margin-top: 20px;
        }
        .teacher-avatar {
            width: 180px; height: 180px; border-radius: 50%; overflow: hidden;
            flex-shrink: 0;
        }
        .teacher-avatar img {
            width: 100%; height: 100%; object-fit: cover; display: block;
        }
        .teacher-info h3 { font-size: 2.2rem; margin-bottom: 8px; color: #0b0b1a; }

        /* RESULTS */
        .check-list {
            list-style: none; max-width: 600px; margin: 0 auto;
            display: grid; gap: 16px;
        }
        .check-list li {
            background: white; padding: 16px 24px; border-radius: 16px;
