        }

        .container { max-width: 1200px; margin: 0 auto; padding: 0 28px; }

        /* HERO */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            background: radial-gradient(ellipse at 30% 40%, #0a0a1a 0%, #020210 100%);
            overflow: hidden;
        }
        .hero::before {
            content: '';
            position: absolute;
            width: 800px; height: 800px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.3) 0%, transparent 70%);
            top: -300px; left: -150px;
            animation: float 12s infinite alternate ease-in-out;
        }
        .hero::after {
            content: '';
            position: absolute;
            width: 700px; height: 700px;
            background: radial-gradient(circle, rgba(139, 92, 246, 0.25) 0%, transparent 70%);
            bottom: -250px; right: -100px;
            animation: float 15s infinite alternate-reverse ease-in-out;
        }
        @keyframes float {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(30px, -30px) scale(1.05); }
        }
        .hero .container {
            position: relative; z-index: 2;
            display: flex; flex-wrap: wrap; align-items: center; gap: 50px;
        }
        .hero-content { flex: 1 1 500px; }
        .hero-badge {
            display: inline-block; background: rgba(255,255,255,0.08);
            backdrop-filter: blur(15px); padding: 10px 24px; border-radius: 40px;
            font-size: 0.9rem; color: #cbd5e1; margin-bottom: 28px;
            border: 1px solid rgba(255,255,255,0.15);
        }
        .hero h1 {
            font-size: clamp(3.2rem, 6vw, 4.8rem); font-weight: 800;
            line-height: 1.08; letter-spacing: -0.02em; color: #ffffff;
            margin-bottom: 24px;
        }
        .hero h1 span {
            background: linear-gradient(135deg, #60a5fa, #a78bfa, #f59e0b);
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
        }
        .hero p {
            font-size: 1.25rem; color: #94a3b8; max-width: 480px; margin-bottom: 36px;
        }
        .btn {
            display: inline-flex; align-items: center; gap: 10px;
            padding: 18px 42px; font-size: 1.1rem; font-weight: 600;
            border-radius: 16px; text-decoration: none; transition: all 0.3s;
            background: linear-gradient(135deg, #4f46e5, #7c3aed);
            color: #fff; box-shadow: 0 12px 30px rgba(79, 70, 229, 0.5);
            border: none; cursor: pointer;
