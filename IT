            background: white; border-radius: 24px; margin-bottom: 16px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.02); overflow: hidden;
        }
        .accordion-header {
            width: 100%; text-align: left; padding: 24px 30px; font-weight: 600;
            font-size: 1.15rem; background: white; border: none; cursor: pointer;
            display: flex; justify-content: space-between; align-items: center;
            color: #1e1b4b;
        }
        .accordion-body { padding: 0 30px 24px; color: #334155; display: none; }
        .accordion-item.active .accordion-body { display: block; }
        .accordion-icon { font-size: 1.8rem; transition: 0.3s; color: #4f46e5; }
